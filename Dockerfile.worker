# Scan worker image: Node + git + Gitleaks + Semgrep. Runs `npm run worker`.
FROM node:22-bookworm-slim
ARG GITLEAKS_VERSION=8.24.3
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates curl python3 python3-pip \
 && pip3 install --break-system-packages --no-cache-dir semgrep \
 && curl -sSL "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_x64.tar.gz" | tar -xz -C /usr/local/bin gitleaks \
 && apt-get purge -y curl && apt-get autoremove -y && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm install --no-save tsx
COPY tsconfig.json ./
COPY src ./src
# Scans run as an unprivileged user in a throwaway temp dir.
RUN useradd -m scanner
USER scanner
ENV NODE_ENV=production WORKER_CONCURRENCY=2
CMD ["npx", "tsx", "src/worker/index.ts"]
