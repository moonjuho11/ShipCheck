# ---- Core ----
APP_URL=http://localhost:3000
# Supabase → Project settings → Database → Connection string (URI). Use the pooler on port 6543 in serverless hosts.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/seaproof
# 32+ random bytes each: `openssl rand -hex 32`
SESSION_SECRET=
ENCRYPTION_KEY=

# ---- GitHub OAuth App (login + private repo access) ----
# Callback URL: ${APP_URL}/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- GitHub App (optional: PR checks + read-only clone tokens) ----
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# PEM, with newlines escaped as \n
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=

# ---- Stripe ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# One-time $29 price and recurring $49/month price
STRIPE_PRICE_REPO=
STRIPE_PRICE_PRO=

# ---- Claude (optional: plain-English explanations + extra review) ----
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5-5
SEAPROOF_MODEL=

# ---- Dev-only switches (ignored when NODE_ENV=production) ----
# Allow file:///path repo URLs so you can scan samples locally
SEAPROOF_ALLOW_LOCAL_REPOS=0
# Allow live-site checks against localhost
SEAPROOF_ALLOW_PRIVATE_TARGETS=0

# ---- Tests ----
# A throwaway database: the worker and scan-limit tests wipe it. They're skipped if this is unset.
TEST_DATABASE_URL=
